#!/usr/bin/env bash
#ddev-generated
## Description: Export module workspaces to static files (SVG, Mermaid) that render on GitHub
## Usage: c4-export [module...]
## Example: "ddev c4-export" or "ddev c4-export my_module"

set -euo pipefail
. "${DDEV_APPROOT}/.ddev/structurizr/lib.sh"

has_format() { [[ ",$FORMATS," == *",$1,"* ]]; }

# Run containers as the host user so exported files are not owned by root.
DOCKER_OPTS=(--rm --user "$CONTAINER_USER" -e HOME=/tmp)

structurizr_export() { # <workspace dir> <tmp dir> <format> <subdir>
  docker run "${DOCKER_OPTS[@]}" -v "$1":/usr/local/structurizr:ro -v "$2":/out "$IMAGE" \
    export -workspace /usr/local/structurizr/workspace.dsl -format "$3" -output "/out/$4" >/dev/null
}

export_workspace() {
  local name="$1" src out tmp f view
  require_workspace "$name"
  src="$(source_dir "$name")"
  out="$(export_dir "$name")"
  # Next to the target, so the final move stays on one filesystem.
  tmp="$(dirname "$out")/.tmp-export-$name"
  rm -rf "$tmp"; mkdir -p "$tmp/mermaid" "$tmp/puml" "$tmp/final"
  # Don't leave a half-finished export behind if a step fails.
  trap "rm -rf $(printf %q "$tmp")" EXIT

  if has_format mermaid; then
    structurizr_export "$src" "$tmp" mermaid mermaid
    for f in "$tmp"/mermaid/*.mmd; do
      [ -e "$f" ] || continue
      view="$(basename "$f" .mmd)"; view="${view#structurizr-}"
      cp "$f" "$tmp/final/$view.mmd"
      # GitHub renders Mermaid only inside Markdown code fences.
      { echo '```mermaid'; cat "$f"; echo; echo '```'; } > "$tmp/final/$view.md"
    done
  fi

  if has_format svg || has_format puml; then
    structurizr_export "$src" "$tmp" plantuml/structurizr puml
    local files=()
    for f in "$tmp"/puml/*.puml; do
      [ -e "$f" ] || continue
      files+=("/data/$(basename "$f")")
    done
    if has_format svg && [ ${#files[@]} -gt 0 ]; then
      docker run "${DOCKER_OPTS[@]}" -v "$tmp/puml":/data "$PLANTUML_IMAGE" -tsvg "${files[@]}" >/dev/null
    fi
    for f in "$tmp"/puml/*; do
      [ -e "$f" ] || continue
      view="$(basename "$f")"; view="${view#structurizr-}"
      case "$f" in
        *.svg) cp "$f" "$tmp/final/$view" ;;
        *.puml) has_format puml && cp "$f" "$tmp/final/$view" ;;
      esac
    done
  fi

  # Index page: GitHub shows it when browsing the folder; link it from ARCHITECTURE.md.
  local views
  views="$(for f in "$tmp"/final/*.svg "$tmp"/final/*.mmd; do
    [ -e "$f" ] && basename "${f%.*}"
  done | sort -u | grep -v -- '-key$' || true)"
  {
    echo "<!-- Generated by 'ddev c4-export' from $(rel "$src")/workspace.dsl. Do not edit. -->"
    echo "# $name"
    for view in $views; do
      echo; echo "## $view"; echo
      if [ -e "$tmp/final/$view.svg" ]; then
        echo "![$view]($view.svg)"
      else
        cat "$tmp/final/$view.md"
      fi
    done
  } > "$tmp/final/README.md"

  # Replace the old export completely, so deleted views disappear too.
  rm -rf "$out"
  mv "$tmp/final" "$out"
  rm -rf "$tmp"
  echo "$name -> $(rel "$out")/ ($(ls "$out" | wc -l | tr -d ' ') files)"
}

if [ $# -gt 0 ]; then
  names=("$@")
else
  names=()
  while IFS= read -r n; do names+=("$n"); done < <(workspaces)
fi

if [ ${#names[@]} -eq 0 ]; then
  no_workspaces_hint
  exit 1
fi

for n in "${names[@]}"; do export_workspace "$n"; done
